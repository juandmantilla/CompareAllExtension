{
  "manifest_version": 3,
  "name": "CompareAll — Comparador de Precios Colombia",
  "short_name": "CompareAll",
  "version": "1.0.0",
  "description": "Rastrea precios en Falabella, Alkosto y Éxito. Historial de hasta 2 años, mejor precio y múltiples perfiles.",
  "author": "CompareAll",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CompareAll — Mejor Precio"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "*://*.falabella.com.co/*",
    "*://*.alkosto.com/*",
    "*://*.exito.com/*",
    "*://*.algolia.net/*",
    "*://*.duckduckgo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.falabella.com.co/*"
      ],
      "js": ["content-scripts/utils.js", "content-scripts/falabella.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.alkosto.com/*"
      ],
      "js": ["content-scripts/utils.js", "content-scripts/alkosto.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.exito.com/*"
      ],
      "js": ["content-scripts/utils.js", "content-scripts/exito.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "lib/*.js"],
      "matches": [
        "*://*.falabella.com.co/*",
        "*://*.alkosto.com/*",
        "*://*.exito.com/*"
      ]
    }
  ]
}
